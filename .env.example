NODE_ENV=development
PORT=3000
# The public address of this CRM. Invites, password resets, payment links and
# walk-in QR codes are all built from it, so it must be reachable from a phone.
# Startup refuses to run in production while this points at localhost.
APP_URL=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/real_estate_crm
SESSION_SECRET=change-me
UPLOAD_DIR=public/uploads
PRIVATE_UPLOAD_DIR=private-uploads
