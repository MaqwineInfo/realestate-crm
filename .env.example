NODE_ENV=development
PORT=3000
# The public address of this CRM. Invites, password resets, payment links and
# walk-in QR codes are all built from it, so it must be reachable from a phone.
# Startup refuses to run in production while this points at localhost.
APP_URL=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/real_estate_crm
SESSION_SECRET=change-me
UPLOAD_DIR=public/uploads
PRIVATE_UPLOAD_DIR=private-uploads

# --- Society module (SOCIETY-PLAN.md) ---
# The society API surfaces (resident app, gate device, society admin) authenticate
# with a bearer JWT rather than the session cookie. Two audiences, two keys: a
# resident token must never verify against the admin surface. Startup refuses to
# run in production while either is unset or the two are equal.
SOCIETY_JWT_SECRET_USER=change-me-society-user
SOCIETY_JWT_SECRET_ADMIN=change-me-society-admin
SOCIETY_JWT_USER_EXPIRY=30d
SOCIETY_JWT_ADMIN_EXPIRY=7d
SOCIETY_OTP_TTL_MINUTES=10
# Development only. Set this and every OTP the module issues is this code, so a
# local login does not need a real SMS. Ignored when NODE_ENV=production — the
# source's hardcoded backdoor phone numbers were deliberately not ported.
SOCIETY_OTP_DEV_CODE=123456
