<%- include('../../partials/app-head') %>

<div class="page-head">
  <div class="grow">
    <h1>Projects</h1>
    <div class="sub">One project record powers inventory, pricing, the mini site and AI.</div>
  </div>
  <% if (can('project.create')) { %><a class="btn btn-primary" href="/app/projects/new">New project</a><% } %>
</div>

<% if (!projects.length) { %>
  <div class="card">
    <%- include('../../partials/empty', {
      heading: 'No projects yet',
      message: 'Create your first project to start capturing and selling inventory.',
      ctaHref: can('project.create') ? '/app/projects/new' : null,
      ctaLabel: 'Create project'
    }) %>
  </div>
<% } else { %>
  <div class="project-grid">
    <% projects.forEach(function (p) {
         const cover = (p.media || []).find(function (m) { return m.kind === 'COVER'; })
           || (p.media || []).find(function (m) { return m.kind === 'GALLERY'; });
         const total = p.stats.total || 0;
         // Sold-through, not availability — it is the number that says how the project is doing.
         const pct = function (n) { return total ? Math.round((n / total) * 100) : 0; };
    %>
      <article class="project-card">
        <a class="pc-cover" href="/app/projects/<%= p._id %>" aria-label="<%= p.name %>">
          <% if (cover) { %>
            <img src="<%= cover.url %>" alt="" loading="lazy">
          <% } else { %>
            <span class="pc-cover-fallback" aria-hidden="true"><%= (p.name || '?').trim().charAt(0).toUpperCase() %></span>
          <% } %>
          <span class="badge <%= p.status === 'ACTIVE' ? 'b-green' : (p.status === 'DRAFT' ? 'b-slate' : 'b-amber') %> pc-status"><%= p.status.replace('_', ' ') %></span>
        </a>

        <div class="pc-body">
          <h2 class="pc-name"><a href="/app/projects/<%= p._id %>"><%= p.name %></a></h2>
          <div class="pc-meta"><%= p.city || 'Location not set' %><%= p.developerName ? ' · ' + p.developerName : '' %></div>

          <% if (total) { %>
            <%# One bar reads faster than three numbers: booked, blocked, free. %>
            <div class="pc-meter" role="img"
                 aria-label="<%= p.stats.booked %> booked, <%= p.stats.blocked %> blocked, <%= p.stats.available %> available of <%= total %> units">
              <span class="seg is-booked" style="width:<%= pct(p.stats.booked) %>%"></span>
              <span class="seg is-blocked" style="width:<%= pct(p.stats.blocked) %>%"></span>
            </div>
            <div class="pc-legend">
              <span><b><%= p.stats.available %></b> available</span>
              <span><b><%= p.stats.blocked %></b> blocked</span>
              <span><b><%= p.stats.booked %></b> booked</span>
            </div>
          <% } else { %>
            <p class="small muted pc-empty mb-0">No units yet — add a block to begin.</p>
          <% } %>

          <div class="pc-foot">
            <span class="pc-price">
              <% if (p.startingPriceMinor) { %>
                From <b><%= h.moneyShort(p.startingPriceMinor) %></b><% if (p.priceRangeMaxMinor) { %> – <%= h.moneyShort(p.priceRangeMaxMinor) %><% } %>
              <% } else { %>
                <span class="faint">Price not set</span>
              <% } %>
            </span>
            <span class="btn-group">
              <a class="btn btn-sm" href="/app/inventory/<%= p._id %>">Inventory</a>
              <% if (p.miniSite && p.miniSite.published) { %>
                <a class="btn btn-sm" target="_blank" rel="noopener" href="/p/<%= p.slug %>">Site</a>
              <% } %>
            </span>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('../../partials/app-foot') %>
