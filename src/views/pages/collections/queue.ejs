<%- include('../../partials/app-head') %>
<%
  const tabQuery = (t) => {
    const params = new URLSearchParams(query || {});
    params.set('tab', t);
    params.delete('page');
    return '/app/collections?' + params.toString();
  };
  const agingLabels = { CURRENT: 'Not due', '1-30': '1–30 days', '31-60': '31–60 days', '61-90': '61–90 days', '90+': '90+ days' };
%>

<div class="page-head">
  <div class="grow">
    <h1>Collections</h1>
    <div class="sub">Work top to bottom. Most overdue first, then what is due today.</div>
  </div>
  <div class="btn-group">
    <a class="btn" href="/app/bookings">All bookings</a>
  </div>
</div>

<%# §150: tiles first, and every count is the exact query its tab lists (§279). %>
<div class="tiles">
  <% tiles.forEach(function (t) { %>
    <a class="tile <%= t.tone %> <%= tab === t.tab ? 'active' : '' %>" href="<%= tabQuery(t.tab) %>">
      <div class="num"><%= t.count %></div>
      <div class="lbl"><%= t.label %></div>
    </a>
  <% }) %>
</div>

<div class="grid cols-4 mb-2">
  <div class="card"><div class="card-body">
    <div class="stat-num"><%= h.moneyShort(snapshot.outstandingMinor) %></div>
    <div class="stat-lbl">Outstanding</div>
  </div></div>
  <div class="card"><div class="card-body">
    <div class="stat-num"><%= h.moneyShort(snapshot.dueThisMonthMinor) %></div>
    <div class="stat-lbl">Due this month</div>
  </div></div>
  <div class="card"><div class="card-body">
    <div class="stat-num"><%= h.moneyShort(snapshot.overdueMinor) %></div>
    <div class="stat-lbl">Overdue</div>
  </div></div>
  <div class="card"><div class="card-body">
    <div class="stat-num"><%= h.moneyShort(snapshot.receivedMinor) %></div>
    <div class="stat-lbl">Received to date</div>
  </div></div>
</div>

<% if (isManagerView) { %>
  <%# §153/§201: where the money is stuck, by age. %>
  <div class="card mb-2">
    <div class="card-head"><h2 class="grow">Overdue by age</h2></div>
    <div class="card-body">
      <table class="responsive">
        <thead><tr><th>Bucket</th><th class="num">Bookings</th><th class="num">Amount</th></tr></thead>
        <tbody>
          <% Object.keys(aging.buckets).forEach(function (key) { %>
            <% if (aging.counts[key]) { %>
              <tr>
                <td data-label="Bucket"><%= agingLabels[key] %></td>
                <td data-label="Bookings" class="num"><%= aging.counts[key] %></td>
                <td data-label="Amount" class="num"><%= h.money(aging.buckets[key]) %></td>
              </tr>
            <% } %>
          <% }) %>
          <% if (!Object.values(aging.counts).some(Boolean)) { %>
            <tr><td colspan="3" class="muted small">Nothing overdue.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<form class="filters" method="get" action="/app/collections">
  <input type="hidden" name="tab" value="<%= tab %>">
  <div class="field">
    <label for="c-q">Search</label>
    <input type="search" id="c-q" name="q" value="<%= query.q || '' %>" placeholder="Customer, mobile or booking no.">
  </div>
  <div class="field">
    <label for="c-project">Project</label>
    <select id="c-project" name="projectId">
      <option value="">All projects</option>
      <% projects.forEach(function (p) { %>
        <option value="<%= p._id %>" <%= String(query.projectId) === String(p._id) ? 'selected' : '' %>><%= p.name %></option>
      <% }) %>
    </select>
  </div>
  <% if (owners.length) { %>
    <div class="field">
      <label for="c-owner">Collection owner</label>
      <select id="c-owner" name="collectionOwnerUserId">
        <option value="">Anyone</option>
        <% owners.forEach(function (u) { %>
          <option value="<%= u._id %>" <%= String(query.collectionOwnerUserId) === String(u._id) ? 'selected' : '' %>><%= u.name %></option>
        <% }) %>
      </select>
    </div>
  <% } %>
  <div class="field">
    <label for="c-sort">Sort by</label>
    <select id="c-sort" name="sortBy">
      <option value="priority" <%= query.sortBy === 'priority' || !query.sortBy ? 'selected' : '' %>>Priority</option>
      <option value="due" <%= query.sortBy === 'due' ? 'selected' : '' %>>Due date</option>
      <option value="outstanding" <%= query.sortBy === 'outstanding' ? 'selected' : '' %>>Outstanding</option>
      <option value="aging" <%= query.sortBy === 'aging' ? 'selected' : '' %>>Days overdue</option>
    </select>
  </div>
  <button class="btn" type="submit">Filter</button>
</form>

<div class="card">
  <div class="card-head">
    <h2 class="grow"><%= tabLabel %></h2>
    <span class="muted small"><%= total %> booking<%= total === 1 ? '' : 's' %></span>
  </div>

  <% if (!items.length) { %>
    <% if (tab === 'due-today') { %>
      <%- include('../../partials/empty', { heading: 'No payments due today', message: 'Nothing on your collection list falls due today.', ctaHref: null, ctaLabel: '' }) %>
    <% } else if (tab === 'overdue') { %>
      <%- include('../../partials/empty', { heading: 'No overdue collections', message: 'Every installment assigned to you is inside its due date.', ctaHref: null, ctaLabel: '' }) %>
    <% } else if (tab === 'ptp-today') { %>
      <%- include('../../partials/empty', { heading: 'No promises due today', message: 'A promise to pay appears here on the day the customer said they would pay.', ctaHref: null, ctaLabel: '' }) %>
    <% } else if (tab === 'missed-followup') { %>
      <%- include('../../partials/empty', { heading: 'Nothing missed', message: 'Every collection follow-up due so far has been completed.', ctaHref: null, ctaLabel: '' }) %>
    <% } else { %>
      <%- include('../../partials/empty', { heading: 'No collections assigned', message: 'Bookings appear here once they are assigned to you for collection.', ctaHref: '/app/bookings', ctaLabel: 'All bookings' }) %>
    <% } %>
  <% } else { %>
    <div class="table-wrap wide"><table class="responsive" data-queue="collections">
      <thead>
        <tr>
          <th>Customer</th><th>Project / unit</th><th>Next due</th>
          <th class="num">Due</th><th class="num">Outstanding</th><th>Aging</th>
          <th>Last / next</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function (b) {
             const contact = b.contactId || {};
             const summary = [contact.displayName, (b.projectId||{}).name, (b.unitId||{}).unitNumber].filter(Boolean).join(' · '); %>
          <tr>
            <td data-label="Customer">
              <a href="/app/bookings/<%= b._id %>"><strong><%= contact.displayName || 'Customer' %></strong></a>
              <div class="small muted"><%= h.mobile(contact.primaryMobile) %></div>
              <% if (b.openPromise) { %>
                <span class="badge b-amber">Promised <%= h.moneyShort(b.openPromise.promisedAmountMinor) %> by <%= h.date(b.openPromise.promisedDate) %></span>
              <% } %>
            </td>
            <td data-label="Project / unit">
              <%= (b.projectId || {}).name || '—' %>
              <div class="small muted"><%= (b.unitId || {}).unitNumber || '' %></div>
            </td>
            <td data-label="Next due">
              <%= b.nextDueAt ? h.date(b.nextDueAt) : 'TBD' %>
              <% if (b.overdueDaysMax > 0) { %>
                <div class="small text-danger"><%= b.overdueDaysMax %> day<%= b.overdueDaysMax === 1 ? '' : 's' %> overdue</div>
              <% } %>
            </td>
            <td data-label="Due" class="num"><%= h.moneyShort(b.nextDueAmountMinor) %></td>
            <td data-label="Outstanding" class="num"><%= h.moneyShort(b.outstandingMinor) %></td>
            <td data-label="Aging"><%= agingLabels[b.aging] %></td>
            <td data-label="Last / next">
              <% if (b.lastFollowUp) { %>
                <div class="small">Last: <%= b.lastFollowUp.actionType.toLowerCase() %> · <%= (b.lastFollowUp.outcome || '').replace(/_/g,' ').toLowerCase() %></div>
              <% } %>
              <% if (b.nextFollowUp) { %>
                <div class="small <%= h.isOverdue(b.nextFollowUp.dueAt) ? '' : 'muted' %>">
                  Next: <%= b.nextFollowUp.actionType.toLowerCase() %> · <%= h.dateTime(b.nextFollowUp.dueAt) %>
                  <% if (h.isOverdue(b.nextFollowUp.dueAt)) { %><span class="badge b-red">missed</span><% } %>
                </div>
              <% } else if (b.outstandingMinor > 0) { %>
                <span class="badge b-red">No next action</span>
              <% } %>
            </td>
            <td data-label="">
              <div class="btn-group">
                <% if (can('collection.followup') && b.nextFollowUp) { %>
                  <button type="button" class="btn btn-sm btn-primary"
                          data-collect="1"
                          data-action="/api/collection-followups/<%= b.nextFollowUp._id %>/complete"
                          data-summary="<%= summary %> — outstanding <%= h.money(b.outstandingMinor) %>"
                          data-outstanding="<%= b.outstandingMinor %>">Log</button>
                <% } %>
                <a class="btn btn-sm" href="/app/bookings/<%= b._id %>">Open</a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <%- include('../../partials/pagination') %>
  <% } %>
</div>

<%- include('../../partials/collection-drawer') %>
<%- include('../../partials/app-foot') %>
