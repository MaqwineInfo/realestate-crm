<%- include('../../partials/cp-head') %>
<%
  const editable = ['DRAFT', 'CORRECTION_REQUIRED'].includes(invoice.status) && !partnerReadOnly;
%>
<div class="page-head">
  <div class="grow">
    <h1><%= invoice.invoiceNumber || invoice.invoiceRef %></h1>
    <div class="sub">
      <%= invoice.invoiceDate ? h.date(invoice.invoiceDate) : 'no date' %>
      · <span class="badge"><%= invoice.status.toLowerCase().replace(/_/g,' ') %></span>
    </div>
  </div>
  <a class="btn" href="/cp/invoices">All invoices</a>
</div>

<% if (invoice.reviewNote && ['CORRECTION_REQUIRED','REJECTED'].includes(invoice.status)) { %>
  <div class="flash flash-warn"><strong>From the review team:</strong> <%= invoice.reviewNote %></div>
<% } %>

<div class="grid cols-2">
  <div class="card">
    <div class="card-head"><h2 class="grow">Invoice</h2></div>
    <div class="card-body">
      <dl class="dl">
        <dt>Taxable value</dt><dd><%= h.money(invoice.taxableValueMinor) %></dd>
        <dt>GST</dt><dd><%= h.money(invoice.gstAmountMinor || 0) %></dd>
        <dt>Other adjustment</dt><dd><%= h.money(invoice.otherAdjustmentMinor || 0) %></dd>
        <dt>Total</dt><dd><strong><%= h.money(invoice.invoiceTotalMinor) %></strong></dd>
        <dt>Paid</dt><dd><%= h.money(invoice.paidAmountMinor || 0) %></dd>
        <dt>GSTIN</dt><dd><%= invoice.gstin || '—' %></dd>
        <dt>PAN</dt><dd><%= invoice.pan || '—' %></dd>
      </dl>
      <% if (invoice.invoicePdf && invoice.invoicePdf.storageKey) { %>
        <a class="btn btn-sm" href="/cp/invoices/<%= invoice._id %>/pdf" target="_blank" rel="noopener">Open invoice PDF</a>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2 class="grow">Payouts</h2></div>
    <% if (!payouts.length) { %>
      <div class="card-body"><p class="muted mb-0">No payout recorded yet.</p></div>
    <% } else { %>
      <table class="responsive">
        <thead><tr><th>Date</th><th class="num">Amount</th><th>Reference</th></tr></thead>
        <tbody>
          <% payouts.forEach(function (p) { %>
            <tr>
              <td data-label="Date"><%= h.date(p.payoutDate) %></td>
              <td data-label="Amount" class="num"><%= h.money(p.amountMinor) %></td>
              <td data-label="Reference"><%= p.transactionReference || '—' %>
                <% if (p.deductionMinor) { %><div class="small muted">deduction <%= h.money(p.deductionMinor) %><%= p.deductionNote ? ' · ' + p.deductionNote : '' %></div><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="card-body"><p class="small muted mb-0">Deductions shown are informational.</p></div>
    <% } %>
  </div>
</div>

<div class="card mt-2">
  <div class="card-head"><h2 class="grow">Lines</h2></div>
  <table class="responsive">
    <thead><tr><th>Booking</th><th>Customer</th><th>Project / unit</th><th class="num">Collected</th><th class="num">Eligible</th><th class="num">Claimed</th></tr></thead>
    <tbody>
      <% lines.forEach(function (l) { %>
        <tr>
          <td data-label="Booking"><%= (l.booking || {}).bookingNumber || '—' %></td>
          <td data-label="Customer"><%= l.customerName || '—' %></td>
          <td data-label="Project / unit">
            <%= ((l.booking || {}).projectId || {}).name || '—' %>
            <span class="muted small"><%= ((l.booking || {}).unitId || {}).unitNumber || '' %></span>
          </td>
          <td data-label="Collected" class="num"><%= l.collectedPct %>%</td>
          <td data-label="Eligible" class="num"><%= h.money(l.eligibleCommissionMinor) %></td>
          <td data-label="Claimed" class="num"><%= h.money(l.invoiceClaimAmountMinor) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (editable) { %>
  <div class="grid cols-2 mt-2">
    <div class="card">
      <div class="card-head"><h2 class="grow">Attach the invoice PDF</h2></div>
      <div class="card-body">
        <form method="post" action="/cp/invoices/<%= invoice._id %>/pdf" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label for="file">Invoice PDF</label>
            <input type="file" id="file" name="file" accept="application/pdf,image/jpeg,image/png" required>
          </div>
          <button class="btn" type="submit">Upload</button>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2 class="grow">Submit for review</h2></div>
      <div class="card-body">
        <p class="small muted">Once submitted, the invoice is locked until the review team responds.</p>
        <form method="post" action="/cp/invoices/<%= invoice._id %>/submit">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-primary" type="submit">Submit invoice</button>
        </form>
      </div>
    </div>
  </div>
<% } %>

<% if (invoice.previousVersions && invoice.previousVersions.length) { %>
  <div class="card mt-2">
    <div class="card-head"><h2 class="grow">Earlier submissions</h2></div>
    <table class="responsive">
      <thead><tr><th>Submitted</th><th>Number</th><th class="num">Total</th><th>Correction asked for</th></tr></thead>
      <tbody>
        <% invoice.previousVersions.forEach(function (v) { %>
          <tr>
            <td data-label="Submitted"><%= v.submittedAt ? h.date(v.submittedAt) : '—' %></td>
            <td data-label="Number"><%= v.invoiceNumber || '—' %></td>
            <td data-label="Total" class="num"><%= h.money(v.invoiceTotalMinor || 0) %></td>
            <td data-label="Correction asked for" class="small"><%= v.correctionNote || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../../partials/cp-foot') %>
