<%- include('../../partials/cp-head') %>
<div class="page-head"><div class="grow"><h1>My team</h1>
  <div class="sub">Who can submit leads under your company.</div></div></div>

<div class="card mb-2">
  <div class="card-head"><h2 class="grow">Members</h2></div>
  <table class="responsive">
    <thead><tr><th>Name</th><th>Mobile</th><th>Designation</th><th>Portal</th><th>Status</th></tr></thead>
    <tbody>
      <% members.forEach(function (m) { %>
        <tr>
          <td data-label="Name"><%= m.name %></td>
          <td data-label="Mobile"><%= m.mobile || '—' %></td>
          <td data-label="Designation"><%= m.designation || '—' %></td>
          <td data-label="Portal"><%= m.portalLoginEnabled ? m.portalRole.toLowerCase().replace('_',' ') : 'no login' %></td>
          <td data-label="Status"><span class="badge <%= m.active ? 'b-green' : 'b-slate' %>"><%= m.active ? 'active' : 'inactive' %></span></td>
        </tr>
      <% }) %>
      <% if (!members.length) { %><tr><td colspan="5" class="muted small">No team members yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<% if (!partnerReadOnly) { %>
  <div class="card mb-2">
    <div class="card-head"><h2 class="grow">Add a member</h2></div>
    <div class="card-body">
      <form method="post" action="/cp/team">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field-row">
          <div class="field"><label for="name">Name</label><input type="text" id="name" name="name" maxlength="150" required></div>
          <div class="field"><label for="mobile">Mobile</label><input type="tel" id="mobile" name="mobile" maxlength="20"></div>
          <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" maxlength="150"></div>
          <div class="field"><label for="designation">Designation</label><input type="text" id="designation" name="designation" maxlength="120"></div>
        </div>
        <label class="check"><input type="checkbox" name="canSubmitLeads" value="1" checked> May submit leads</label>
        <button class="btn" type="submit">Add member</button>
        <p class="small muted mb-0 mt-1">
          Portal logins and invoice rights are set up by the developer's channel partner team.
        </p>
      </form>
    </div>
  </div>
<% } %>

<% if (performance.length) { %>
  <div class="card">
    <div class="card-head"><h2 class="grow">Team performance</h2></div>
    <table class="responsive">
      <thead><tr><th>Member</th><th class="num">Leads</th><th class="num">Visits</th><th class="num">Bookings</th><th class="num">Value</th></tr></thead>
      <tbody>
        <% performance.forEach(function (r) { %>
          <tr>
            <td data-label="Member"><%= r.name %></td>
            <td data-label="Leads" class="num"><%= r.leads %></td>
            <td data-label="Visits" class="num"><%= r.visits %></td>
            <td data-label="Bookings" class="num"><%= r.bookings %></td>
            <td data-label="Value" class="num"><%= h.moneyShort(r.bookingValueMinor) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../../partials/cp-foot') %>
