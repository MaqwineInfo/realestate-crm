<%- include('../../partials/app-head') %>

<div class="page-head">
  <div class="grow">
    <h1>Campaign performance</h1>
    <div class="sub">
      Spend → leads → visits → blocks → bookings → revenue, attributed on
      <strong><%= attributionModel.replace('_', ' ').toLowerCase() %></strong> (§39.2, §93).
    </div>
  </div>
  <div class="btn-group">
    <% if (can('setup.attribution')) { %>
      <form method="post" action="/api/campaigns/attribution">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="attributionModel" value="<%= attributionModel === 'FIRST_TOUCH' ? 'LAST_TOUCH' : 'FIRST_TOUCH' %>">
        <button class="btn" type="submit">Switch to <%= attributionModel === 'FIRST_TOUCH' ? 'last' : 'first' %> touch</button>
      </form>
    <% } %>
    <% if (can('campaign.edit_spend')) { %><button class="btn btn-primary" data-drawer="drawer-campaign">Add campaign</button><% } %>
  </div>
</div>

<div class="card mb-2">
  <div class="card-body">
    <form class="filters" method="get" action="/app/campaigns/performance">
      <div class="field"><label for="from">From</label><input type="date" id="from" name="from" value="<%= query.from || '' %>"></div>
      <div class="field"><label for="to">To</label><input type="date" id="to" name="to" value="<%= query.to || '' %>"></div>
      <div class="field">
        <label for="projectId">Project</label>
        <select id="projectId" name="projectId">
          <option value="">All</option>
          <% projects.forEach(function (p) { %><option value="<%= p._id %>" <%= String(query.projectId) === String(p._id) ? 'selected' : '' %>><%= p.name %></option><% }) %>
        </select>
      </div>
      <button class="btn btn-primary" type="submit">Apply</button>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-head"><h2 class="grow">Spend to booking</h2><span class="muted small">Switching the model never deletes history (§40.2)</span></div>
  <% if (!rows.length) { %>
    <%- include('../../partials/empty', {
      heading: 'No campaign data yet',
      message: 'Connect an ad platform or add a manual campaign to see spend against real bookings.',
      ctaHref: null, ctaLabel: ''
    }) %>
  <% } else { %>
    <div class="table-wrap wide"><table class="responsive">
      <thead>
        <tr>
          <th>Campaign</th><th class="num">Spend</th><th class="num">Leads</th><th class="num">CPL</th>
          <th class="num">Visits</th><th class="num">Cost/visit</th><th class="num">Bookings</th>
          <th class="num">Cost/booking</th><th class="num">Revenue</th><th class="num">ROAS</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td data-label="Campaign">
              <span class="t-name"><%= r.name %></span>
              <div class="t-sub"><%= r.platform %><%= r.projectId ? ' · ' + r.projectId.name : '' %><%= r.lastSyncAt ? ' · synced ' + h.rel(r.lastSyncAt) : '' %></div>
            </td>
            <td data-label="Spend" class="num"><%= h.moneyShort(r.spendMinor || 0) %></td>
            <td data-label="Leads" class="num"><%= r.leads %></td>
            <td data-label="CPL" class="num"><%= r.cplMinor != null ? h.money(r.cplMinor) : '—' %></td>
            <td data-label="Visits" class="num"><%= r.visits %></td>
            <td data-label="Cost/visit" class="num"><%= r.costPerVisitMinor != null ? h.money(r.costPerVisitMinor) : '—' %></td>
            <td data-label="Bookings" class="num"><strong><%= r.bookings %></strong></td>
            <td data-label="Cost/booking" class="num"><%= r.costPerBookingMinor != null ? h.moneyShort(r.costPerBookingMinor) : '—' %></td>
            <td data-label="Revenue" class="num"><%= h.moneyShort(r.revenueMinor) %></td>
            <td data-label="ROAS" class="num">
              <% if (r.roas != null) { %>
                <span class="badge <%= r.roas >= 1 ? 'b-green' : 'b-red' %>"><%= r.roas %>×</span>
              <% } else { %>—<% } %>
            </td>
          </tr>
        <% }) %>
        <tr>
          <td class="right"><strong>Total</strong></td>
          <td class="num"><strong><%= h.moneyShort(totals.spendMinor) %></strong></td>
          <td class="num"><strong><%= totals.leads %></strong></td>
          <td class="num"><%= totals.cplMinor != null ? h.money(totals.cplMinor) : '—' %></td>
          <td class="num"><strong><%= totals.visits %></strong></td>
          <td class="num"><%= totals.costPerVisitMinor != null ? h.money(totals.costPerVisitMinor) : '—' %></td>
          <td class="num"><strong><%= totals.bookings %></strong></td>
          <td class="num"><%= totals.costPerBookingMinor != null ? h.moneyShort(totals.costPerBookingMinor) : '—' %></td>
          <td class="num"><strong><%= h.moneyShort(totals.revenueMinor) %></strong></td>
          <td class="num"><%= totals.roas != null ? totals.roas + '×' : '—' %></td>
        </tr>
      </tbody>
    </table></div>
    <div class="card-body">
      <p class="small muted mb-0">
        A campaign with a higher cost per lead but more bookings is the better campaign — compare the
        bookings and ROAS columns, not CPL alone (§91).
      </p>
    </div>
  <% } %>
</div>

<% if (unattributed && unattributed.leads) { %>
  <div class="card">
    <div class="card-head"><h2 class="grow">Not attributed to any campaign</h2></div>
    <div class="card-body">
      <dl class="dl">
        <dt>Leads</dt><dd><%= unattributed.leads %></dd>
        <dt>Visits</dt><dd><%= unattributed.visits %></dd>
        <dt>Bookings</dt><dd><%= unattributed.bookings %></dd>
        <dt>Revenue</dt><dd><%= h.moneyShort(unattributed.revenueMinor) %></dd>
      </dl>
      <p class="small muted mb-0">Walk-ins, referrals and direct enquiries land here.</p>
    </div>
  </div>
<% } %>

<% if (can('campaign.edit_spend')) { %>
  <%- include('../../partials/drawer-open', { id: 'drawer-campaign', heading: 'Add campaign', action: '/api/campaigns/marketing' }) %>
    <div class="field">
      <label for="mc-name">Campaign name</label>
      <input type="text" id="mc-name" name="name" required maxlength="150">
    </div>
    <div class="field-row">
      <div class="field">
        <label for="mc-platform">Platform</label>
        <select id="mc-platform" name="platform" required>
          <% ['META','GOOGLE','LINKEDIN','PROPERTY_PORTAL','OFFLINE','OTHER'].forEach(function (p) { %>
            <option value="<%= p %>"><%= p.replace('_',' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="mc-project">Project</label>
        <select id="mc-project" name="projectId">
          <option value="">All projects</option>
          <% projects.forEach(function (p) { %><option value="<%= p._id %>"><%= p.name %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="field-row">
      <div class="field"><label for="mc-start">Start date</label><input type="date" id="mc-start" name="startDate"></div>
      <div class="field"><label for="mc-end">End date</label><input type="date" id="mc-end" name="endDate"></div>
    </div>
    <div class="field">
      <label for="mc-spend">Spend</label>
      <input type="text" id="mc-spend" name="spend" inputmode="decimal">
    </div>
    <div class="field">
      <label for="mc-external">External campaign ID <span class="opt">optional</span></label>
      <input type="text" id="mc-external" name="externalCampaignId" maxlength="80">
      <div class="hint">Captured leads carrying this id are attributed to this campaign.</div>
    </div>
  <%- include('../../partials/drawer-close', { cta: 'Add campaign' }) %>
<% } %>

<%- include('../../partials/app-foot') %>
