<%- include('../../partials/app-head') %>
<%- include('../../partials/back-link', { href: '/app/society/societies', label: 'Societies' }) %>
<%- include('../../partials/society-detail-nav') %>

<div class="page-head">
  <div class="grow">
    <h1><%= society.societyName %> — onboarding requests</h1>
    <div class="sub">Residents claiming a unit from the app. Approving is what creates their access.</div>
  </div>
</div>

<form class="filters" method="get">
  <div class="field">
    <label for="o-status">Status</label>
    <select id="o-status" name="status">
      <option value="">Any</option>
      <% ['Pending', 'Approved', 'Rejected'].forEach(function (s) { %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
      <% }); %>
    </select>
  </div>
  <button class="btn" type="submit">Filter</button>
</form>

<div class="card">
  <% if (!requests.length) { %>
    <%- include('../../partials/empty', {
      heading: 'Nothing waiting',
      message: 'Requests submitted from the resident app appear here for approval.'
    }) %>
  <% } else { %>
    <div class="table-wrap wide"><table class="responsive">
      <thead><tr><th>Applicant</th><th>Unit</th><th>Claiming</th><th>Family</th><th>Submitted</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% requests.forEach(function (r) { %>
          <tr>
            <td data-label="Applicant">
              <strong><%= [r.firstName, r.lastName].filter(Boolean).join(' ') %></strong>
              <div class="small muted"><%= (r.countryCode || '') + (r.mobileNumber || '') %></div>
            </td>
            <td data-label="Unit"><%= r.unitId ? r.unitId.unitNumber : '—' %></td>
            <td data-label="Claiming">
              <span class="badge <%= r.residentType === 'Owner' ? 'b-green' : 'b-amber' %>"><%= r.residentType %></span>
            </td>
            <td data-label="Family" class="num"><%= (r.familyMembers || []).length %></td>
            <td data-label="Submitted"><%= h.date(r.createdAt) %></td>
            <td data-label="Status">
              <span class="badge <%= r.status === 'Approved' ? 'b-green' : (r.status === 'Rejected' ? 'b-red' : 'b-amber') %>"><%= r.status %></span>
              <% if (r.rejectedReason) { %><div class="small muted"><%= r.rejectedReason %></div><% } %>
            </td>
            <td data-label="">
              <% if (r.status === 'Pending') { %>
                <div class="btn-group">
                  <form method="post" action="/app/society/societies/<%= society._id %>/onboarding/<%= r._id %>" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="action" value="approve">
                    <button class="btn btn-sm btn-primary" type="submit">Approve</button>
                  </form>
                  <form method="post" action="/app/society/societies/<%= society._id %>/onboarding/<%= r._id %>" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="action" value="reject">
                    <button class="btn btn-sm btn-ghost" type="submit">Reject</button>
                  </form>
                </div>
              <% } else { %>
                <span class="muted small">Processed</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>
    <%- include('../../partials/pagination', { page: pagination.page, pages: pagination.totalPages, total: pagination.total, query: filters }) %>
  <% } %>
</div>

<%- include('../../partials/app-foot') %>
