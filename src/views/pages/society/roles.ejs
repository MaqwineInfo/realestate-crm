<%- include('../../partials/app-head') %>
<%- include('../../partials/society-nav') %>

<div class="page-head">
  <div class="grow">
    <h1>Society roles</h1>
    <div class="sub">
      Who can do what inside a society. Separate from CRM roles — a chairman is not a CRM user.
    </div>
  </div>
</div>

<div class="card">
  <% if (!roles.length) { %>
    <%- include('../../partials/empty', { heading: 'No roles', message: 'Seed the society roles to let chairmen sign in.' }) %>
  <% } else { %>
    <div class="table-wrap wide"><table class="responsive">
      <thead>
        <tr><th>Role</th><th>Key</th><th class="num">Level</th><th>Scope</th><th class="num">Admins</th><th>Permissions</th><th></th></tr>
      </thead>
      <tbody>
        <% roles.forEach(function (r) { %>
          <tr>
            <td data-label="Role">
              <strong><%= r.displayName %></strong>
              <% if (r.isSystem) { %> <span class="badge b-slate">System</span><% } %>
              <% if (r.description) { %><div class="small muted"><%= r.description %></div><% } %>
            </td>
            <td data-label="Key"><code><%= r.key %></code></td>
            <td data-label="Level" class="num"><%= r.level %></td>
            <td data-label="Scope"><span class="badge <%= r.scope === 'global' ? 'b-amber' : 'b-slate' %>"><%= r.scope %></span></td>
            <td data-label="Admins" class="num"><%= r.adminCount %></td>
            <td data-label="Permissions"><span class="small muted"><%= (r.permissions || []).join(', ') || '—' %></span></td>
            <td data-label="">
              <% if (!r.isSystem && r.adminCount === 0) { %>
                <form method="post" action="/app/society/roles/<%= r._id %>/delete" style="display:inline"
                      onsubmit="return confirm('Delete the <%= r.displayName %> role?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-ghost" type="submit">Delete</button>
                </form>
              <% } else { %>
                <span class="muted small"><%= r.isSystem ? 'System role' : r.adminCount + ' in use' %></span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>
  <% } %>
</div>

<%- include('../../partials/app-foot') %>
