<%- include('../../partials/app-head') %>
<%- include('_pb-nav') %>

<div class="grid cols-4 mb-2">
  <div class="card"><div class="card-body">
    <div class="stat-num"><%= h.moneyShort(data.totals.scheduledMinor) %></div>
    <div class="stat-lbl">Scheduled</div>
  </div></div>
  <div class="card"><div class="card-body">
    <div class="stat-num"><%= h.moneyShort(data.totals.receivedMinor) %></div>
    <div class="stat-lbl">Received · <%= data.totals.collectionPct %>%</div>
  </div></div>
  <div class="card"><div class="card-body">
    <div class="stat-num"><%= h.moneyShort(data.totals.outstandingMinor) %></div>
    <div class="stat-lbl">Outstanding</div>
  </div></div>
  <div class="card"><div class="card-body">
    <div class="stat-num"><%= h.moneyShort(data.totals.overdueMinor) %></div>
    <div class="stat-lbl">Overdue</div>
  </div></div>
</div>

<div class="grid cols-2 mb-2">
  <div class="card">
    <div class="card-head"><h2 class="grow">Ageing</h2></div>
    <div class="table-wrap wide"><table class="responsive">
      <thead><tr><th>Bucket</th><th class="num">Installments</th><th class="num">Amount</th></tr></thead>
      <tbody>
        <% data.aging.filter(function (a) { return a.count; }).forEach(function (a) { %>
          <tr><td data-label="Bucket"><%= a.bucket %></td><td data-label="Installments" class="num"><%= a.count %></td><td data-label="Amount" class="num"><%= h.money(a.amountMinor) %></td></tr>
        <% }) %>
        <% if (!data.aging.some(function (a) { return a.count; })) { %>
          <tr><td colspan="3" class="muted small">Nothing overdue in this range.</td></tr>
        <% } %>
      </tbody>
    </table></div>
  </div>
  <div class="card">
    <div class="card-head">
      <h2 class="grow">Money in, this range</h2>
      <span class="muted small"><%= h.money(data.totals.receiptsInRangeMinor) %></span>
    </div>
    <div class="table-wrap wide"><table class="responsive">
      <thead><tr><th>Mode</th><th class="num">Receipts</th><th class="num">Amount</th></tr></thead>
      <tbody>
        <% data.byMode.forEach(function (m) { %>
          <tr><td data-label="Mode"><%= m.mode.replace(/_/g,' ').toLowerCase() %></td><td data-label="Receipts" class="num"><%= m.count %></td><td data-label="Amount" class="num"><%= h.money(m.amountMinor) %></td></tr>
        <% }) %>
        <% if (!data.byMode.length) { %><tr><td colspan="3" class="muted small">No payments recorded in this range.</td></tr><% } %>
      </tbody>
    </table></div>
    <div class="card-body">
      <p class="small muted mb-0">
        Promise to pay open: <%= h.money(data.totals.ptpOpenMinor) %> ·
        missed: <%= data.totals.ptpMissed %> ·
        payment links sent: <%= data.totals.paymentLinksSent %> (paid <%= data.totals.paymentLinksPaid %>)
      </p>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2 class="grow">Installments</h2>
    <span class="muted small"><%= data.rows.length %> row<%= data.rows.length === 1 ? '' : 's' %></span>
  </div>
  <% if (!data.rows.length) { %>
    <%- include('../../partials/empty', { heading: 'Nothing to show', message: 'No installments match these filters.', ctaHref: null, ctaLabel: '' }) %>
  <% } else { %>
    <div class="table-wrap wide"><table class="responsive">
      <thead>
        <tr>
          <th>Customer</th><th>Project / unit</th><th>Milestone</th><th>Due</th>
          <th class="num">Scheduled</th><th class="num">Received</th><th class="num">Outstanding</th>
          <th>Status</th><th>Ageing</th><th>Collection</th>
        </tr>
      </thead>
      <tbody>
        <% data.rows.forEach(function (r) { const b = r.booking || {}; %>
          <tr>
            <td data-label="Customer">
              <a href="/app/bookings/<%= b._id %>?tab=collections"><%= (b.contactId || {}).displayName || '—' %></a>
              <div class="small muted"><%= b.bookingNumber || '' %></div>
            </td>
            <td data-label="Project / unit"><%= (b.projectId || {}).name || '—' %> <span class="muted small"><%= (b.unitId || {}).unitNumber || '' %></span></td>
            <td data-label="Milestone"><%= r.milestone %></td>
            <td data-label="Due"><%= r.dueDate ? h.date(r.dueDate) : 'TBD' %></td>
            <td data-label="Scheduled" class="num"><%= h.moneyShort(r.scheduledAmountMinor) %></td>
            <td data-label="Received" class="num"><%= h.moneyShort(r.amountReceivedMinor || 0) %></td>
            <td data-label="Outstanding" class="num"><%= h.moneyShort(r.outstandingMinor) %></td>
            <td data-label="Status">
              <span class="badge <%= r.overdue ? 'b-red' : '' %>"><%= r.overdue ? r.overdueDays + 'd overdue' : r.status.toLowerCase() %></span>
            </td>
            <td data-label="Ageing"><%= r.aging %></td>
            <td data-label="Collection"><%= ((b.collectionOwnerUserId) || {}).name || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>

<%- include('../../partials/app-foot') %>
