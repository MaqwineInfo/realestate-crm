<%- include('../../partials/app-head') %>

<div class="page-head">
  <div class="grow">
    <%- include('../../partials/back-link', { href: '/app/contacts', label: 'Contacts' }) %>
    <h1>New contact</h1>
    <div class="sub">One person, one record. The mobile number is what keeps it that way.</div>
  </div>
  <a class="btn btn-ghost" href="/app/contacts">Cancel</a>
</div>

<form method="post" action="/api/contacts">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card" style="max-width:680px">
    <div class="card-body">
      <%- include('../../partials/contact-form', { contact: null, idPrefix: 'new' }) %>
      <div class="btn-group mt-2">
        <button class="btn btn-primary" type="submit">Create contact</button>
        <a class="btn btn-ghost" href="/app/contacts">Cancel</a>
      </div>
    </div>
  </div>
</form>

<%- include('../../partials/app-foot') %>
