<%- include('../../partials/app-head') %>
<div class="page-head">
  <div class="grow">
    <h1>Partner lead claims</h1>
    <div class="sub">A disputed submission changes nothing until someone decides it.</div>
  </div>
  <a class="btn" href="/app/channel-partners/dashboard">CP dashboard</a>
</div>

<div class="tiles">
  <% counts.forEach(function (c) { %>
    <a class="tile <%= c.status === 'CONFLICT' ? 'bad' : (c.status === 'PENDING' ? 'warn' : '') %> <%= activeStatus === c.status ? 'active' : '' %>"
       href="/app/channel-partners/claims?status=<%= c.status %>">
      <div class="num"><%= c.count %></div>
      <div class="lbl"><%= c.status.toLowerCase() %></div>
    </a>
  <% }) %>
</div>

<div class="card">
  <div class="card-head">
    <h2 class="grow"><%= activeStatus.toLowerCase() %> claims</h2>
    <span class="muted small"><%= total %> record<%= total === 1 ? '' : 's' %></span>
  </div>

  <% if (!items.length) { %>
    <%- include('../../partials/empty', { heading: 'Nothing to review', message: 'A partner submission only lands here when it collides with an existing lead or partner.', ctaHref: '/app/channel-partners/dashboard', ctaLabel: 'CP dashboard' }) %>
  <% } else { %>
    <div class="table-wrap wide"><table class="responsive">
      <thead>
        <tr><th>Claim</th><th>Customer</th><th>Project</th><th>Claiming partner</th>
        <th>Existing</th><th>Reason</th><th>Claimed</th><th></th></tr>
      </thead>
      <tbody>
        <% items.forEach(function (c) {
             const claimer = (c.channelPartnerId || {}).profile || {};
             const existingCp = (c.existingChannelPartnerId || {}).profile || null; %>
          <tr>
            <td data-label="Claim"><%= c.claimNumber %></td>
            <td data-label="Customer">
              <strong><%= (c.contactId || {}).displayName || c.submittedName %></strong>
              <div class="small muted"><%= h.mobile(c.submittedMobile) %></div>
            </td>
            <td data-label="Project"><%= (c.projectId || {}).name || '—' %></td>
            <td data-label="Claiming partner">
              <a href="/app/channel-partners/<%= (c.channelPartnerId || {})._id %>">
                <%= claimer.tradeName || claimer.legalName || claimer.primaryContactName || 'Partner' %>
              </a>
              <% if ((c.channelPartnerId || {}).status !== 'ACTIVE') { %>
                <div class="small"><span class="badge b-amber"><%= ((c.channelPartnerId || {}).status || '').toLowerCase() %></span></div>
              <% } %>
            </td>
            <td data-label="Existing">
              <% if (existingCp) { %>
                <div>Partner: <%= existingCp.tradeName || existingCp.legalName %></div>
              <% } %>
              <% if (c.existingOwnerUserId) { %><div class="small">Owner: <%= c.existingOwnerUserId.name %></div><% } %>
              <% if (c.existingSourceId) { %><div class="small muted">Source: <%= c.existingSourceId.name %></div><% } %>
              <% if (!existingCp && !c.existingOwnerUserId) { %><span class="muted small">—</span><% } %>
            </td>
            <td data-label="Reason">
              <span class="badge b-amber"><%= (c.conflictReason || '').toLowerCase().replace(/_/g,' ') %></span>
              <% if (c.conflictNote) { %><div class="small muted"><%= c.conflictNote %></div><% } %>
            </td>
            <td data-label="Claimed"><%= h.date(c.submittedAt) %></td>
            <td data-label="">
              <% if (canReview && ['PENDING','CONFLICT'].includes(c.status)) { %>
                <button type="button" class="btn btn-sm btn-primary" data-drawer="drawer-claim-<%= c._id %>">Decide</button>
              <% } else if (c.reviewNote) { %>
                <span class="small muted"><%= c.reviewNote %></span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <%- include('../../partials/pagination') %>
  <% } %>
</div>

<% if (canReview) { %>
  <% items.filter(function (c) { return ['PENDING','CONFLICT'].includes(c.status); }).forEach(function (c) { %>
    <div class="drawer-backdrop" id="drawer-claim-<%= c._id %>" hidden>
      <div class="drawer" role="dialog" aria-modal="true" aria-label="Decide claim">
        <form method="post" action="/api/channel-partner-claims/<%= c._id %>/review">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="returnTo" value="<%= path %>?status=<%= activeStatus %>">
          <div class="drawer-head">
            <h2 class="grow">Claim <%= c.claimNumber %></h2>
            <button type="button" class="btn btn-ghost btn-sm" data-drawer-close>Close</button>
          </div>
          <div class="drawer-body">
            <div class="read-only-summary">
              <%= c.submittedName %> · <%= h.mobile(c.submittedMobile) %>
              <%= (c.projectId || {}).name ? ' · ' + c.projectId.name : '' %>
            </div>
            <p class="small muted"><%= c.conflictNote || 'Decide who this customer belongs to.' %></p>
            <div class="field">
              <label for="dec-<%= c._id %>">Decision</label>
              <select id="dec-<%= c._id %>" name="decision">
                <option value="ACCEPTED">Accept this partner's claim</option>
                <option value="KEEP_EXISTING">Keep the existing partner or owner</option>
                <option value="REJECTED">Reject the claim</option>
              </select>
            </div>
            <div class="field">
              <label for="note-<%= c._id %>">Reason</label>
              <textarea id="note-<%= c._id %>" name="note" rows="2" maxlength="500"></textarea>
              <span class="hint">Recorded on the partner's timeline and in the audit log.</span>
            </div>
            <p class="small muted mb-0">
              Accepting attaches this partner to the lead. It never changes who owns the lead
              internally, or the marketing source it came from.
            </p>
          </div>
          <div class="drawer-foot">
            <button type="button" class="btn" data-drawer-close>Cancel</button>
            <button type="submit" class="btn btn-primary">Save decision</button>
          </div>
        </form>
      </div>
    </div>
  <% }) %>
<% } %>
<%- include('../../partials/app-foot') %>
