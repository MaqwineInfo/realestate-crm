<%- include('../../partials/app-head') %>
<div class="page-head">
  <div class="grow">
    <h1>Partner invoices</h1>
    <div class="sub">What partners have claimed, and where each claim stands.</div>
  </div>
  <div class="btn-group">
    <a class="btn" href="/app/channel-partners/dashboard">CP dashboard</a>
    <% if (can('cp.report.view')) { %><a class="btn" href="/app/reports/cp-invoices">Report</a><% } %>
  </div>
</div>

<div class="tiles">
  <% counts.filter(function (c) { return c.count; }).forEach(function (c) { %>
    <a class="tile <%= ['SUBMITTED','UNDER_REVIEW'].includes(c.status) ? 'warn' : '' %> <%= query.status === c.status ? 'active' : '' %>"
       href="/app/channel-partners/invoices?status=<%= c.status %>">
      <div class="num"><%= c.count %></div>
      <div class="lbl"><%= c.status.toLowerCase().replace(/_/g,' ') %></div>
    </a>
  <% }) %>
</div>

<div class="card">
  <div class="card-head">
    <h2 class="grow">Invoices</h2>
    <span class="muted small"><%= total %> record<%= total === 1 ? '' : 's' %></span>
    <% if (query.status) { %><a class="btn btn-sm btn-ghost" href="/app/channel-partners/invoices">Clear</a><% } %>
  </div>
  <% if (!items.length) { %>
    <%- include('../../partials/empty', { heading: 'No partner invoices', message: 'A partner raises an invoice once their commission becomes eligible.', ctaHref: '/app/channel-partners/dashboard', ctaLabel: 'CP dashboard' }) %>
  <% } else { %>
    <div class="table-wrap"><table class="responsive">
      <thead>
        <tr><th>Invoice</th><th>Partner</th><th>Date</th><th class="num">Total</th>
        <th class="num">Paid</th><th>Lines</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% items.forEach(function (i) { const pr = (i.channelPartnerId || {}).profile || {}; %>
          <tr>
            <td data-label="Invoice">
              <a href="/app/channel-partners/invoices/<%= i._id %>"><%= i.invoiceNumber || i.invoiceRef %></a>
              <div class="small muted"><%= i.invoiceRef %></div>
            </td>
            <td data-label="Partner">
              <%= pr.tradeName || pr.legalName || pr.primaryContactName || '—' %>
              <% if ((i.channelPartnerId || {}).reraStatus === 'EXPIRED') { %>
                <div class="small"><span class="badge b-red">RERA expired</span></div>
              <% } %>
            </td>
            <td data-label="Date"><%= i.invoiceDate ? h.date(i.invoiceDate) : '—' %></td>
            <td data-label="Total" class="num"><%= h.money(i.invoiceTotalMinor) %></td>
            <td data-label="Paid" class="num"><%= h.money(i.paidAmountMinor || 0) %></td>
            <td data-label="Lines"><%= (i.lines || []).length %></td>
            <td data-label="Status">
              <span class="badge <%= i.status === 'PAID' ? 'b-green' : (['REJECTED','CANCELLED'].includes(i.status) ? 'b-red' : (['SUBMITTED','UNDER_REVIEW'].includes(i.status) ? 'b-amber' : '')) %>">
                <%= i.status.toLowerCase().replace(/_/g,' ') %>
              </span>
            </td>
            <td data-label="">
              <a class="btn btn-sm" href="/app/channel-partners/invoices/<%= i._id %>">
                <%= ['SUBMITTED','UNDER_REVIEW'].includes(i.status) && can('cp.invoice.review') ? 'Review' : 'Open' %>
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <%- include('../../partials/pagination') %>
  <% } %>
</div>
<%- include('../../partials/app-foot') %>
