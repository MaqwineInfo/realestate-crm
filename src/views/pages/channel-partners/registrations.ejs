<%- include('../../partials/app-head') %>
<div class="page-head">
  <div class="grow">
    <h1>Partner registrations</h1>
    <div class="sub">Applications waiting on us, and what each one is missing.</div>
  </div>
  <div class="btn-group">
    <a class="btn" href="/app/channel-partners">All partners</a>
    <% if (can('cp.partner.create')) { %><a class="btn btn-primary" href="/app/channel-partners/registrations/new">New application</a><% } %>
  </div>
</div>

<form class="filters" method="get" action="/app/channel-partners/registrations">
  <div class="field">
    <label for="r-q">Search</label>
    <input type="search" id="r-q" name="q" value="<%= query.q || '' %>" placeholder="Name, number or mobile">
  </div>
  <div class="field">
    <label for="r-status">Status</label>
    <select id="r-status" name="status">
      <option value="">Any</option>
      <% statuses.forEach(function (s) { %>
        <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s.toLowerCase().replace(/_/g,' ') %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="r-type">Type</label>
    <select id="r-type" name="partnerType">
      <option value="">Any</option>
      <option value="COMPANY" <%= query.partnerType === 'COMPANY' ? 'selected' : '' %>>Company</option>
      <option value="INDIVIDUAL" <%= query.partnerType === 'INDIVIDUAL' ? 'selected' : '' %>>Individual</option>
    </select>
  </div>
  <div class="field">
    <label for="r-city">City</label>
    <input type="text" id="r-city" name="city" value="<%= query.city || '' %>">
  </div>
  <button class="btn" type="submit">Filter</button>
</form>

<div class="card">
  <div class="card-head">
    <h2 class="grow">Applications</h2>
    <span class="muted small"><%= total %> record<%= total === 1 ? '' : 's' %></span>
  </div>
  <% if (!items.length) { %>
    <%- include('../../partials/empty', { heading: 'No applications', message: 'Start one internally, or send a partner an invitation link.', ctaHref: can('cp.partner.create') ? '/app/channel-partners/registrations/new' : null, ctaLabel: 'New application' }) %>
  <% } else { %>
    <div class="table-wrap wide"><table class="responsive">
      <thead>
        <tr><th>Application</th><th>Partner</th><th>Type</th><th>Contact</th><th>City</th>
        <th>RERA</th><th>Submitted</th><th>Status</th><th>Reviewer</th><th></th></tr>
      </thead>
      <tbody>
        <% items.forEach(function (r) { const pr = r.profile || {}; %>
          <tr>
            <td data-label="Application">
              <a href="/app/channel-partners/registrations/<%= r._id %>"><%= r.registrationNumber %></a>
              <div class="small muted"><%= r.submissionSource.toLowerCase().replace('_',' ') %></div>
            </td>
            <td data-label="Partner">
              <%= pr.tradeName || pr.legalName || pr.primaryContactName %>
              <% if (r.possibleDuplicates && r.possibleDuplicates.length) { %>
                <div class="small"><span class="badge b-amber">possible duplicate</span></div>
              <% } %>
            </td>
            <td data-label="Type"><%= (pr.partnerType || '').toLowerCase() %></td>
            <td data-label="Contact">
              <%= pr.primaryContactName || '—' %>
              <div class="small muted"><%= h.mobile(pr.mobile) %></div>
            </td>
            <td data-label="City"><%= pr.city || '—' %></td>
            <td data-label="RERA">
              <% if (r.rera) { %>
                <%= r.rera.registrationNumber %>
                <div class="small">
                  <span class="badge <%= r.rera.verificationStatus === 'VERIFIED' ? 'b-green' : '' %>"><%= r.rera.verificationStatus.toLowerCase() %></span>
                  <% if (r.rera.expiryDate) { %> · <%= h.date(r.rera.expiryDate) %><% } %>
                </div>
              <% } else { %>
                <span class="badge b-red">missing</span>
              <% } %>
            </td>
            <td data-label="Submitted"><%= r.submittedAt ? h.date(r.submittedAt) : '—' %></td>
            <td data-label="Status">
              <span class="badge <%= r.status === 'APPROVED' ? 'b-green' : (r.status === 'REJECTED' ? 'b-red' : (r.status === 'DRAFT' ? '' : 'b-amber')) %>">
                <%= r.status.toLowerCase().replace(/_/g,' ') %>
              </span>
            </td>
            <td data-label="Reviewer"><%= (r.reviewedBy || {}).name || '—' %></td>
            <td data-label="">
              <a class="btn btn-sm" href="/app/channel-partners/registrations/<%= r._id %>">
                <%= ['SUBMITTED','UNDER_REVIEW'].includes(r.status) && can('cp.registration.review') ? 'Review' : 'Open' %>
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <%- include('../../partials/pagination') %>
  <% } %>
</div>
<%- include('../../partials/app-foot') %>
