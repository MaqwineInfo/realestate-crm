<%- include('../../partials/head') %>
<div class="public-wrap">
  <div class="public-hero">
    <h1><%= project.name %></h1>
    <p class="muted"><%= project.city || '' %><%= project.landmark ? ' · ' + project.landmark : '' %></p>

    <% if (done) { %>
      <div class="flash flash-success">
        Thank you — you're checked in. Our sales team will be with you shortly.
      </div>
    <% } else { %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="flash flash-error"><%= error %></div>
      <% } %>
      <p>Please share a few details so our team can help you.</p>
      <form method="post" action="/visit/<%= project.qrToken %>">
        <div class="field">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" required maxlength="80" autofocus>
        </div>
        <div class="field">
          <label for="mobile">Mobile number</label>
          <input type="tel" id="mobile" name="mobile" required inputmode="tel">
        </div>
        <div class="field">
          <label for="email">Email <span class="opt">optional</span></label>
          <input type="email" id="email" name="email">
        </div>
        <div class="field">
          <label for="visitingWith">Visiting with</label>
          <select id="visitingWith" name="visitingWith" data-cp-select>
            <option value="DIRECT">Directly</option>
            <option value="CHANNEL_PARTNER">Channel partner / broker</option>
          </select>
        </div>
        <div data-cp-panel hidden>
          <div class="field">
            <label for="cpName">Channel partner name</label>
            <input type="text" id="cpName" name="cpName" maxlength="120">
          </div>
          <div class="field">
            <label for="cpMobile">Channel partner mobile <%= requireCpMobile ? '' : '<span class="opt">optional</span>' %></label>
            <input type="tel" id="cpMobile" name="cpMobile" <%= requireCpMobile ? 'required' : '' %>>
          </div>
        </div>
        <div class="field">
          <label for="visitorCount">Number of visitors</label>
          <input type="number" id="visitorCount" name="visitorCount" min="1" value="1">
        </div>
        <button class="btn btn-primary btn-block" type="submit">Check in</button>
      </form>
    <% } %>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
